# ---------------------------------------------------------------------------
# Configuration de l'application — modèle à copier en `.env`
# Ne jamais versionner le fichier `.env` : il contient les secrets locaux.
# ---------------------------------------------------------------------------

# Identité du produit
APP_NAME="Agentic Knowledge Workspace"
# Base URL absolue. Laisser vide → URLs relatives (ok pour `php -S ... -t public`).
# Sous WAMP en sous-dossier : APP_URL="http://localhost/ai-knowledge-workspace/public"
APP_URL=

# Environnement : local | testing | production
APP_ENV=production
APP_DEBUG=0
APP_PREVIEW=0

APP_TIMEZONE=UTC
APP_LOCALE=fr

# Session
SESSION_NAME=AKW_SESSION
SESSION_IDLE=1800

# Base de données MySQL 8.4.13
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ai_knowledge_workspace
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Meta Model API (à renseigner avec les clés fournies par le hackathon)
META_MODEL_API_BASE_URL=
META_MODEL_API_KEY=
META_MODEL_NAME=muse-wonder-1.0
META_EMBEDDING_MODEL=open-weight-embedding
META_EMBEDDING_MODE=local
# "meta" = API Meta (/v1/responses) ; "openai" = partenaire (/v1/chat/completions)
META_API_STYLE=meta

# SMTP — nécessaire pour les invitations et liens de récupération
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="AI Knowledge Workspace"

# Anonymise extracted content before indexing (0 or 1)
ANONYMISATION=0
