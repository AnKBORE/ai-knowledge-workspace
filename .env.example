# ---------------------------------------------------------------------------
# Configuration de l'application — modèle à copier en `.env`
# Ne jamais versionner le fichier `.env` : il contient les secrets locaux.
# ---------------------------------------------------------------------------

# Identité du produit
APP_NAME="Agentic Knowledge Workspace"
# Base URL absolue. Laisser vide → URLs relatives (ok pour `php -S ... -t public`).
# Sous WAMP en sous-dossier : APP_URL="http://localhost/ai-knowledge-workspace/public"
APP_URL=

# Environnement : local | testing | production
APP_ENV=production
APP_DEBUG=0
APP_PREVIEW=0

APP_TIMEZONE=UTC
APP_LOCALE=fr

# Session
SESSION_NAME=AKW_SESSION
SESSION_IDLE=1800

# Base de données MySQL 8.4.13
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ai_knowledge_workspace
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Meta Model API (à renseigner avec les clés fournies par le hackathon)
# Baseten (hackathon) : base URL sans /v1, modèle exact avec le suffixe -1026
META_MODEL_API_BASE_URL=https://inference.baseten.co
META_MODEL_API_KEY=
META_MODEL_NAME=meta-models/muse-spark-open-1026
META_EMBEDDING_MODEL=open-weight-embedding
META_EMBEDDING_MODE=local
# "meta" = API Meta (/v1/responses) ; "openai" = partenaire (/v1/chat/completions)
META_API_STYLE=openai
# OCR (images, PDF scannés) : délai par page et budget de raisonnement (low|medium|high)
# META_VISION_TIMEOUT=300
# META_VISION_REASONING_EFFORT=low
# Optionnel — déploiement Baseten dédié Whisper Large V3 Turbo (GPU facturé à la minute
# sur l'organisation propriétaire ; la clé hackathon ne sert que muse-spark-open-1026)
# META_BASETEN_WHISPER_URL=https://model-XXXXXXX.api.baseten.co/environments/production/predict
# META_BASETEN_WHISPER_KEY=
# META_BASETEN_WHISPER_LANGUAGE=fr
# Optionnel — whisper.cpp local (gratuit, hors ligne, verbatim, chants compris) :
# binaire whisper-cli + modèle GGML (https://github.com/ggml-org/whisper.cpp)
# META_WHISPER_BIN=C:/chemin/whisper/Release/whisper-cli.exe
# META_WHISPER_MODEL=C:/chemin/whisper/models/ggml-small.bin
# META_WHISPER_ARGS=-nt -l auto

# SMTP — nécessaire pour les invitations et liens de récupération
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="AI Knowledge Workspace"

# Anonymise extracted content before indexing (0 or 1)
ANONYMISATION=0

# Optional dedicated ASR (Whisper-style) — bypasses the chat model for transcription.
# META_TRANSCRIPTION_MODEL=whisper-large-v3
# META_TRANSCRIPTION_ENDPOINT=/v1/audio/transcriptions
